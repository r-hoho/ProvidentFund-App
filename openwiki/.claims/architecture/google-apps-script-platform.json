    {
      "id": "claim_a35a956dc1194794894ab1f743d2143e",
      "statement": "appsscript.json pins runtimeVersion V8 (modern JS: const, arrow functions, template literals), executeAs USER_DEPLOYING (handlers run under the deploying user while Session.getActiveUser() still resolves to the in-domain caller), access DOMAIN (only in-Workspace users reach the app), timeZone Asia/Bangkok (drives server-side date arithmetic for payroll cut-off and effective dates), and exceptionLogging STACKDRIVER.",
      "evidence": [
        {
          "resource": "repo://CLAUDE.md#L67-L67",
          "version": "repo-lines-v1:sha256:b13aaf23ae8f99dda09fb2b1c0a985bc8eea3fa304aaa25126bac3f37a75c4b8:"
