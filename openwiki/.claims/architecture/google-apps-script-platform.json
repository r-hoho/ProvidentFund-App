        }
      ]
    },
    {
      "id": "claim_e8eb80ce40634f1eb23063c7a9753140",
      "statement": "The include() global server-side function (Main.gs) returns HtmlService.createHtmlOutputFromFile(filename).getContent() and is the helper invoked by every <?!= include('html/...') ?> scriptlet in Index.html to splice CSS, modal, and JS partials into the page; deleting or renaming it breaks all partial loading.",
      "evidence": [
        {
          "resource": "repo://Code/Main.gs#L37-L38",
          "version": "repo-lines-v1:sha256:cf1068746156256d8587141b198426f12bb024fca22879f123781bd685f85027:"
