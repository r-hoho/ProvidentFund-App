    {
      "id": "claim_565d995b72924747b7ce0b51817654d3",
      "statement": "doGet() is the single HTTP entry point and MUST build its HtmlOutput via HtmlService.createTemplateFromFile('html/Index').evaluate(); using createHtmlOutputFromFile instead silently fails to render the <?!= include() ?> scriptlets because that API does not evaluate scriptlets.",
      "evidence": [
        {
          "resource": "repo://CLAUDE.md#L65-L65",
          "version": "repo-lines-v1:sha256:0cda1af289ac5b0cd5517af2e81dbb552d9c8e850fff898f953fa55c3357807f:"
