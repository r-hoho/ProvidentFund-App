        }
      ]
    },
    {
      "id": "claim_0d8574523acf45b9a3c257a1bb663beb",
      "statement": "There is an intentional asymmetry: doGet() uses createTemplateFromFile(...).evaluate() (the only evaluation pass, which resolves nested scriptlets), while include() uses createHtmlOutputFromFile(...).getContent() (raw string injection spliced by the forcing <?!= ?> scriptlet), so include() is not a second evaluation pass.",
      "evidence": [
        {
          "resource": "repo://Code/Main.gs#L4-L38",
          "version": "repo-lines-v1:sha256:a101933266372dba4abd0919c2536a6e57be30f5b50e75f2f2def6dea421f6d9:"
        },
        {
