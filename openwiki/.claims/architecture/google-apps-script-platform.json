        }
      ]
    },
    {
      "id": "claim_d53a6f85299740469e58b1f83174d4aa",
      "statement": "Server-side values are pushed into the template before evaluation by setting properties on the template object (e.g. template.maintenanceActive = isMaintenanceActive in doGet), then become available inside the scriptlet context.",
