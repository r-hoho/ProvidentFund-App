    {
      "id": "claim_2c81f77cafd2425aa1c727817bb71a14",
      "statement": "Cooldown vs ready (states 3 vs 4 for Count=1, 8 vs 9 for Count=2) is decided purely by Last_Withdrawal_Date + 6 months relative to today — there is no separate ready flag; the date is the switch. getUserProfile computes isCoolingDown only when Withdrawal_Count is 1 or 2 and Last_Withdrawal_Date is a real Date, setting unlockDate = lastWithdrawalDate + 6 months.",
      "evidence": [
        {
          "resource": "repo://Code/Profile.gs#L110-L123",
          "version": "repo-lines-v1:sha256:96aa2deded40369ae23f73003ecc09b1994b39ba4f22d79aea88b4573b13f08c:"
