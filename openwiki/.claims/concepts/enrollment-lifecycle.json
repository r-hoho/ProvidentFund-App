    {
      "id": "claim_75c40a0bd18e41b79b9a3c7214ac7553",
      "statement": "A Transaction_ID is owned by the action handler (generated via generateTransactionId with a prefix) and threads through the audit row, the confirmation email, the signed letter, and the patch. Prefixes are EN for enrollment, PC for plan change, WD for withdrawal, BN for beneficiary; the format is <prefix>-<YYYYMMDD>-<4-char-random>.",
