        }
      ]
    },
    {
      "id": "claim_acc1820179654c4cbce53f25b90e6057",
      "statement": "Per-state Enrollments field values: First_Enrolled_Date is set once on first enrollment and never overwritten; Current_Enrolled_Date is the current cycle start (updated on each re-enrollment); Current_Plan is the enrolled flag (set decimal = enrolled, blank = not enrolled); Investment_Plan pairs with it; Last_Withdrawal_Date is blank until a withdrawal and drives the cooldown for counts 1 and 2. Current_Enrolled_Date drives tenure/match/vesting when Withdrawal_Count >= 1 (states 5 and 10 must carry the re-enroll date D1/D2).",
      "evidence": [
        {
          "resource": "repo://Code/Withdraw.gs#L50-L56",
          "version": "repo-lines-v1:sha256:7969548cb59621b526ae0c605bb3b9277092d8ef7c7058a6904513bed815a7a6:"
