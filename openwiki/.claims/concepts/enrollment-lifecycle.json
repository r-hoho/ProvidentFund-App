  "claims": [
    {
      "id": "claim_32c3013a7ff8431eaa24e17799c1db64",
      "statement": "MIGRATION.md formalizes the enrollment lifecycle as 9 cycle states (numbered 1-10, with 6 reserved for terminal lockout) plus a probation flag that overlays state 1. Withdrawal_Count is the spine: 0 through the 1st enrollment, 1 through the 2nd, 2 through the 3rd, and 3 at permanent lockout; it holds steady through each enrollment and ticks up only on a withdrawal.",
      "evidence": [
        {
          "resource": "repo://MIGRATION.md#L50-L70",
          "version": "repo-lines-v1:sha256:8b19b9801f0c1d348b2dd2b4743f31e6d475c3a8ca0b214f1eac0c5c499103a7:"
        }
      ]
    },
    {
      "id": "claim_319e80b8f3214f6db5635ab8bf960171",
      "statement": "States 1 and 7 (never enrolled, fresh) have NO Enrollments row. The only difference between them is Users.Probation_End: a future date in state 7 blocks enrollment, while state 1 is cleared. Probation lives entirely in the Users sheet (getUserProfile sets isOnProbation only when rawProbationDate is a future Date), not in Enrollments.",
      "evidence": [
        {
          "resource": "repo://Code/Profile.gs#L102-L108",
          "version": "repo-lines-v1:sha256:8a6e15c3cafc79743a2c314c521bc41f4ed0b134cac8b10444a446e12985cb35:"
        },
        {
