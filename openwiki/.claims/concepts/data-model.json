  "claims": [
    {
      "id": "claim_18a2d7edeb28456b86d9e4e60cbca374",
      "statement": "The app persists its state in six Google Sheets inside the bound spreadsheet (SpreadsheetApp.getActiveSpreadsheet): Users, Enrollments, Beneficiaries, Audit_Log, App_Feedback, and Monthly_Reporting. Their names are held as constants in Config.gs (SHEET_USERS, SHEET_ENROLLMENTS, SHEET_BENEFICIARIES, SHEET_AUDIT, SHEET_FEEDBACK, SHEET_REPORTING). Monthly_Reporting is declared but not wired to any read or write code.",
      "evidence": [
        {
          "resource": "repo://CLAUDE.md#L37-L47",
          "version": "repo-lines-v1:sha256:dc9ef502ae6288e5afe75737f39fd0dedfca3500bc0864dd8258098eade66739:"
