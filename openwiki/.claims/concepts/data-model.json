    {
      "id": "claim_a734a15b32a04e3ca4f3b16b2ef13cd6",
      "statement": "Date cells must be real Google Sheets Date objects, not text. The code checks instanceof Date before using a date for math (probation, cooldown, tenure, plan-change lock); a string like '2024-01-15' is treated as no date and silently skips cooldown/tenure/lock logic. Withdrawal_Count must be numeric (0/1/2/3), not a string.",
      "evidence": [
        {
          "resource": "repo://Code/Action.gs#L296-L298",
