  "claims": [
    {
      "id": "claim_67e795324d084cd7b87a94b388885d52",
      "statement": "The 6-month plan-change lock is measured from max(Last_Plan_Change_Date, Current_Enrolled_Date); processChangePlan re-derives mostRecentAction from max(lastChangeDate, enrollDate), adds 6 months, and returns a failure with the next-eligible date if today is before that date — this is the one server-side gate actually enforced at write time.",
      "evidence": [
        {
          "resource": "repo://Code/Action.gs#L295-L312",
          "version": "repo-lines-v1:sha256:3da22a518614bc7c1f8c7a41757a59fdbbd4c0e901094b6cc0f31c7f7e24a055:"
        }
      ]
    },
    {
      "id": "claim_0066bff4757a4a588a198a6f6829acdd",
      "statement": "checkPlanChangeEligibility pre-computes the same lock client-side (Math.max of Last_Plan_Change_Date and Current_Enrolled_Date + 6 months) and returns { locked: true, nextDate } or { locked: false }; it is called on JS.html DOMContentLoaded and again after every successful action's home-reload, and its result is stored in planChangeStatus to drive the change-plan modal's locked vs. selectable variant.",
      "evidence": [
        {
          "resource": "repo://Code/Action.gs#L235-L258",
          "version": "repo-lines-v1:sha256:e3f0c4fe8d2f87e8e795d964808878dc2158585ff4a512ba6d2009b1db868499:"
        },
        {
          "resource": "repo://html/JS.html#L5-L19",
          "version": "repo-lines-v1:sha256:8df69bc19e016f403b7a569ddf8af2802775c6aaa8048519b3395652b91a33b5:"
        }
      ]
    },
    {
      "id": "claim_18aa3b31d972404583a12e820972b42a",
      "statement": "The plan-change lock applies only to contribution % — investment-plan changes and beneficiary updates are not throttled by it and are not payroll-cycled; processChangePlan upserts exactly two Enrollments fields (Current_Plan and Last_Plan_Change_Date) and does not touch Withdrawal_Count, Current_Enrolled_Date, or Investment_Plan.",
      "evidence": [
        {
          "resource": "repo://Code/Action.gs#L288-L315",
          "version": "repo-lines-v1:sha256:d76aabc98968d75ac2b498d9c7eaf1f65b52c7536861eb808eed705ec45c73cf:"
        }
      ]
    },
    {
      "id": "claim_6dcb0368a1284f0bb50a2fa92d106d13",
      "statement": "processChangePlan on success upserts exactly two Enrollments fields — Current_Plan = newPlan and Last_Plan_Change_Date = today (which becomes the new anchor for the next 6-month window) — and captures priorValues {Current_Plan, Last_Plan_Change_Date} into the SUBMITTED audit row so a cancel can revert.",
      "evidence": [
        {
          "resource": "repo://Code/Action.gs#L314-L342",
          "version": "repo-lines-v1:sha256:4fda6568b39092579b7be0ffbf10dd90e20b4f8c8006ba9dbc1a7645669e52c4:"
        }
      ]
    },
    {
      "id": "claim_e2f8db7a05574d8ca3bf73b7cf438f6b",
      "statement": "processWithdrawal requires an existing enrolled row (refuses with 'You are not currently enrolled.' if findEnrollmentRowIdx returns -1), then clears Current_Plan and Investment_Plan, sets Last_Withdrawal_Date = today, and increments Withdrawal_Count by 1 — the only place in the codebase the count ticks (it holds steady through every enrollment).",
      "evidence": [
        {
          "resource": "repo://Code/Withdraw.gs#L39-L56",
          "version": "repo-lines-v1:sha256:e5ac06d8639c21de1eec8584a554fdb6d681e36e92f9adf77a5ec78d45fb4912:"
        }
      ]
    },
    {
      "id": "claim_5bc2929edf0242a48aa005f7cc6c0cf1",
      "statement": "processWithdrawal captures priorValues {Withdrawal_Count, Current_Enrolled_Date, Current_Plan, Investment_Plan} into the SUBMITTED audit row so a cancel can fully restore membership state.",
      "evidence": [
        {
          "resource": "repo://Code/Withdraw.gs#L60-L75",
          "version": "repo-lines-v1:sha256:0bbe59243e5c55b9f32148f81d7ddb58174cb18c2f2625479ae4632321463dbc:"
        }
      ]
    },
    {
      "id": "claim_72bbed99df9346ffa4d865d34e6f37a1",
      "statement": "processWithdrawal does not refuse the 3rd withdrawal (it does not check Withdrawal_Count >= 3 before writing); it simply increments to 3, so the permanent lockout takes effect on the next enroll attempt, not at withdrawal time.",
      "evidence": [
        {
          "resource": "repo://Code/Withdraw.gs#L48-L56",
          "version": "repo-lines-v1:sha256:e601e4ffdf4bbcb916f6f85a173c4a2fd3cf57604273db0f4a87c0f603f77366:"
        }
