    },
    {
      "id": "claim_837c2a01291c4957b54e6890323cfa2d",
      "statement": "The 5-year vesting check (tenureY >= 5) is a display rule in the withdrawal modal only — it colors the employer-match eligibility row green or red — and does not gate whether processWithdrawal accepts the request; the actual payout calculation is handled outside the app.",
      "evidence": [
        {
          "resource": "repo://html/JS_Withdraw.html#L14-L27",
          "version": "repo-lines-v1:sha256:1d9222393155dd274952fd8fed38a4926e725f618769632aae9af4eb6e2b6a06:"
        }
