    {
      "id": "claim_b3547611db1446d88d8c62ac9b613590",
      "statement": "isCoolingDown is computed only for Withdrawal_Count 1 or 2 with a real Last_Withdrawal_Date: unlockDate = Last_Withdrawal_Date + 6 months, and isCoolingDown is true when today < unlockDate; the date itself is the switch (no separate flag), and cooldownEndDate is surfaced for the 'Re-enroll on' message.",
      "evidence": [
        {
          "resource": "repo://Code/Profile.gs#L110-L123",
          "version": "repo-lines-v1:sha256:96aa2deded40369ae23f73003ecc09b1994b39ba4f22d79aea88b4573b13f08c:"
