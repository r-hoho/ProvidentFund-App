    {
      "id": "claim_d464761957b84e479fe20980644b30dc",
      "statement": "checkPlanChangeEligibility re-resolves the user by email (separate from getUserProfile), reads Last_Plan_Change_Date and Current_Enrolled_Date, takes max of the two coerced Dates, adds 6 months, and returns {locked:true, nextDate} if today is before that date; a missing user degrades to {locked:false}.",
      "evidence": [
