    {
      "id": "claim_9c1b29c1b6914b238d365d8d484f7ff0",
      "statement": "populateUI is the single success handler for getUserProfile; it stashes response.enrollment into globalEnrollmentData and the whole response into globalUserProfile, renders the in-progress box from pendingTransactions, then runs a strict non-commutative status cascade (lockout → probation → cooldown → enrolled → eligible) where the first matching state short-circuits the rest.",
      "evidence": [
