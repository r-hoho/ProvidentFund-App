        }
      ]
    },
    {
      "id": "claim_f84c89c0f6c7481eb3124834edb2b4a3",
      "statement": "parseDevice_ reduces the raw navigator.userAgent into low-cardinality buckets device_category (desktop/mobile/tablet), device_os (iOS/Android/Windows/macOS/Linux/Other), and device_browser (Edge/Opera/Samsung/Firefox/Chrome/Safari/Other), which must be registered as GA4 custom dimensions; the raw UA is never sent and the ' | WxH' screen suffix is ignored.",
      "evidence": [
        {
          "resource": "repo://Code/Analytics.gs#L70-L116",
          "version": "repo-lines-v1:sha256:1aca71cb06d0867429eed14574821791929f3e691e21f6e683fc60d2fcbef1ee:"
        }
      ]
    },
    {
      "id": "claim_8510fe0860934ddb921bf303d11a5c1d",
      "statement": "Native GA4 device detection is useless for this app because the hits are sent server-side via UrlFetchApp, so GA4 sees Google's datacenter UA/IP rather than the user's; the explicit device_* params from parseDevice_ are the only reliable device signal.",
      "evidence": [
