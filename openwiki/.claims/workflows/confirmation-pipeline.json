    {
      "id": "claim_4aad39d40ce6406ca179ecb5a9995185",
      "statement": "trackFeatureAction and trackAppOpen send server-side GA4 Measurement Protocol events because the GAS web app renders in a sandboxed googleusercontent.com iframe where GA third-party cookies are blocked, so client-side gtag.js cannot reliably track users/sessions/returning; server-side knows the user and sets a stable hashed user_id.",
      "evidence": [
        {
          "resource": "repo://Code/Analytics.gs#L1-L11",
          "version": "repo-lines-v1:sha256:36db8e8b233c0ab14bbf2de319c4b75bd65e315c7b45956d8fa7712c1ca2f556:"
        }
      ]
    },
    {
      "id": "claim_c51fbf0d6dd64c1f92f784c68cf112f4",
      "statement": "The GA4 user_id is SHA-256(salt + email) via hashUserId_, never the raw email or Allstars_ID (PDPA); an optional GA4_USER_ID_SALT makes the hash non-reversible by rainbow table, and any hash-to-identity mapping is kept internal; currentUserHash_ resolves the email defensively and never throws.",
      "evidence": [
        {
          "resource": "repo://Code/Analytics.gs#L13-L15",
          "version": "repo-lines-v1:sha256:6a20412f7febd1a746a6f8739f70ba0910ce39b3c305dc935512f7e98fa82331:"
