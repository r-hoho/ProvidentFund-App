    {
      "id": "claim_af5cb4964a7e4713ac6469c93d16f484",
      "statement": "After an action handler's sheet writes succeed, it runs a fixed best-effort post-commit pipeline — generateLetter, sendActionConfirmation, patchAuditEventData, (conditionally) sendLetterFailureAlert, and trackFeatureAction — and none of these side-effects may throw or roll back the action; the handler returns success even when the email, letter, or analytics call fails.",
      "evidence": [
        {
          "resource": "repo://Code/Action.gs#L100-L166",
          "version": "repo-lines-v1:sha256:42017376d5274616d4315994053633b3e032a6b50f828cab19a4151284fea87a:"
